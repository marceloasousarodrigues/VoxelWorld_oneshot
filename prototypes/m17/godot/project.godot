; M17 renderer evaluation prototype. Native Godot ArrayMesh; no plugins or texture packs.
config_version=5

[application]
config/name="VoxelWorld M17 Native Godot Slice"
run/main_scene="res://scenes/game.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.49, 0.72, 0.89, 1)

[physics]
3d/default_gravity=24.0

[input]
move_forward={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]}
move_backward={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]}
jump={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":32)]}
sprint={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194325)]}
crouch={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194326)]}
break_block={"deadzone": 0.2, "events": [Object(InputEventMouseButton,"button_index":1)]}
place_block={"deadzone": 0.2, "events": [Object(InputEventMouseButton,"button_index":2)]}
release_mouse={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194305)]}
toggle_fly={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":70)]}
toggle_debug={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194334)]}
save_world={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194336)]}
load_saved_world={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194340)]}
open_crafting={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":67)]}
open_inventory={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":73)]}
open_settings={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":79)]}
interact={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":69)]}
slot_1={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":49)]}
slot_2={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":50)]}
slot_3={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":51)]}
slot_4={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":52)]}
